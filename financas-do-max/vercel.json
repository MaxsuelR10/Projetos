{
  "version": 2,
  "crons": [{"path":"/api/notifications/cron","schedule":"0 12 * * *"}],
  "builds": [
    {"src": "api/index.mjs", "use": "@vercel/node"},
    {"src": "dist/**", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/.*", "dest": "/api/index.mjs"},
    {"src": "/", "dest": "/dist/index.html"},
    {"src": "/(.*)", "dest": "/dist/$1"}
  ]
}
