{
  "version": 2,
  "crons": [{"path":"/api/notifications/cron","schedule":"0 12 * * *"}],
  "builds": [
    {"src": "api/index.mjs", "use": "@vercel/node"},
    {"src": "dist/**", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/.*", "dest": "/api/index.mjs"},
    {"src": "/(sw\\.js|manifest\\.webmanifest|.*\\.(?:mjs|js|css))", "headers": {"Cache-Control": "public, max-age=0, must-revalidate"}, "continue": true},
    {"src": "/", "headers": {"Cache-Control": "no-cache"}, "continue": true},
    {"src": "/", "dest": "/dist/index.html"},
    {"src": "/(.*)", "dest": "/dist/$1"}
  ]
}
