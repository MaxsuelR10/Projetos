NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://usuario:senha@localhost:5432/controle_financas?schema=public
JWT_SECRET=substitua-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d
JWT_COOKIE_DAYS=7
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0
# Nunca exponha esta chave no frontend nem a versione no Git.
GEMINI_API_KEY=
# Modelo único, compatível com configurações existentes no provedor. Use
# GEMINI_MODELS quando precisar de uma lista com fallback.
GEMINI_MODEL=gemini-2.5-flash
# Modelos separados por vírgula; use os padrões atuais se não informar.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=25000
GEMINI_CHAT_TIMEOUT_MS=55000
GEMINI_MAX_OUTPUT_TOKENS=4096
